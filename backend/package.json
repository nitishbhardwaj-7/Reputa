{
  "name": "orm-dashboard-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for the ORM (Online Reputation Monitoring) dashboard. Consumes Apify scraper output and AI sentiment analysis; never scrapes directly.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "postinstall": "prisma generate && node scripts/ensure_playwright.js && npm run build",
    "start": "node dist/server.js",
    "backup": "tsx scripts/export_backup.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@types/nodemailer": "^8.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "nodemailer": "^10.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.5",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
