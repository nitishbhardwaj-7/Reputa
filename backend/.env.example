# ============================================================================
# APIFY — the ONLY source of raw social data. The app never scrapes directly.
# ============================================================================

# The exact URL you call to get scraper results. Two common shapes:
#   1) Run an Actor/Task synchronously and get dataset items back directly:
#      https://api.apify.com/v2/acts/<actor-id>/run-sync-get-dataset-items
#      https://api.apify.com/v2/actor-tasks/<task-id>/run-sync-get-dataset-items
#   2) Fetch items from an already-finished dataset:
#      https://api.apify.com/v2/datasets/<dataset-id>/items
APIFY_API_URL=

# Your Apify API token (found in Apify Console -> Settings -> Integrations).
APIFY_API_KEY=

# HTTP method to call APIFY_API_URL with.
#   POST -> runs the actor/task with the input below (use for run-sync-get-dataset-items)
#   GET  -> just fetches items (use for a plain /datasets/<id>/items URL)
APIFY_METHOD=POST

# JSON template sent as the request body when APIFY_METHOD=POST. This is the
# Actor/Task "input" object — its shape is defined BY THE ACTOR YOU CHOSE, so
# it is intentionally not hardcoded here. Use the literal placeholder
# {{keyword}} anywhere you want the searched keyword substituted in.
# Adjust the field names to match whatever input schema your chosen Apify
# Actor expects (check the Actor's Input tab in Apify Console).
APIFY_INPUT_TEMPLATE={"searchTerms":["{{keyword}}"],"maxItems":100}

# Optional: extra query string appended to APIFY_API_URL, e.g. "&clean=true".
APIFY_QUERY_PARAMS=

# Request timeout in ms for the Apify call (actor runs can be slow).
APIFY_TIMEOUT_MS=120000

# ============================================================================
# MISTRAL AI SENTIMENT ANALYSIS
# ============================================================================
AI_API_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_API_KEY=
AI_API_KEY=
AI_MODEL=open-mistral-7b
AI_CONCURRENCY=3

# ============================================================================
# DATABASE
# ============================================================================

# SQLite (default, zero-config): file path relative to backend/prisma
DATABASE_URL="file:./dev.db"
# To use Postgres instead: set provider="postgresql" in prisma/schema.prisma
# and DATABASE_URL="postgresql://user:password@localhost:5432/orm_dashboard"

# ============================================================================
# SERVER
# ============================================================================
PORT=4000
CORS_ORIGIN=http://localhost:5173
