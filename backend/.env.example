# ============================================================================
# SERVER
# ============================================================================
NODE_ENV=development
PORT=4000
APP_NAME=Reputa
# Comma-separated browser origins allowed to call the API with cookies (local dev).
# In production the frontend is served from the same origin via nginx, so this can be empty.
APP_ORIGINS=http://localhost:5173
# At least 32 random characters. Generate: openssl rand -hex 48
JWT_SECRET=
# Set to true behind HTTPS (production).
COOKIE_SECURE=false

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/orm_saas?schema=public

# ============================================================================
# PLATFORM INTEGRATIONS — provided by the operator, shared by all tenants.
# Tenants never see these.
# ============================================================================

# Mistral AI sentiment engine
AI_API_URL=https://api.mistral.ai/v1/chat/completions
AI_API_KEY=
AI_MODEL=open-mistral-7b
AI_CONCURRENCY=3

# Serper.dev — Google / Bing / YouTube / News search scanning
SERPER_API_KEY=

# MongoDB — dedupe cache for the search scanner (one DB per tenant is derived from MONGODB_DB)
MONGODB_URI=
MONGODB_DB=brandmonitor

# SMTP — negative-mention alert emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Python interpreter used to run the scrapers (venv path in production)
PYTHON_EXECUTABLE=python3

# Optional legacy Apify ingestion
APIFY_API_URL=
APIFY_API_KEY=
APIFY_METHOD=POST
APIFY_INPUT_TEMPLATE={"searchTerms":["{{keyword}}"],"maxItems":100}
APIFY_QUERY_PARAMS=
APIFY_TIMEOUT_MS=120000

# ============================================================================
# BILLING
# ============================================================================
# Length of the free trial every new workspace starts on.
TRIAL_DAYS=14
# Public URL of the app (Stripe redirects back here). Defaults to the first APP_ORIGINS entry.
APP_URL=
# Where upgrade requests are emailed while Stripe is not configured. Defaults to SMTP_USER.
OPERATOR_EMAIL=

# Stripe (optional). Leave empty to collect upgrade requests by email instead.
STRIPE_SECRET_KEY=
# From the webhook endpoint https://<domain>/api/billing/webhook
# (events: checkout.session.completed, customer.subscription.*, invoice.payment_failed)
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_YEARLY=

# ============================================================================
# GOOGLE SIGN-IN (optional)
# ============================================================================
# OAuth client ids from Google Cloud Console → APIs & Services → Credentials. Comma-separated:
# the Web client id FIRST (the browser uses it), then the iOS / Android ids for the mobile app.
# Web client: add https://<domain> (and http://localhost:5173 for dev) as Authorized JavaScript origins.
# No client secret is needed; the apps send Google's ID token and the API verifies it.
GOOGLE_CLIENT_IDS=
