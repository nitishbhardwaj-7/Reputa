# ============================================================================
# SERVER
# ============================================================================
NODE_ENV=development
PORT=4000
APP_NAME=Reputa
# Comma-separated browser origins allowed to call the API with cookies (local dev).
# In production the frontend is served from the same origin via nginx, so this can be empty.
APP_ORIGINS=http://localhost:5173
# At least 32 random characters. Generate: openssl rand -hex 48
JWT_SECRET=
# Set to true behind HTTPS (production).
COOKIE_SECURE=false

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/orm_saas?schema=public

# ============================================================================
# PLATFORM INTEGRATIONS — provided by the operator, shared by all tenants.
# Tenants never see these.
# ============================================================================

# Mistral AI sentiment engine
AI_API_URL=https://api.mistral.ai/v1/chat/completions
AI_API_KEY=
AI_MODEL=open-mistral-7b
AI_CONCURRENCY=3

# Serper.dev — Google / Bing / YouTube / News search scanning
SERPER_API_KEY=

# MongoDB — dedupe cache for the search scanner (one DB per tenant is derived from MONGODB_DB)
MONGODB_URI=
MONGODB_DB=brandmonitor

# SMTP — negative-mention alert emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Python interpreter used to run the scrapers (venv path in production)
PYTHON_EXECUTABLE=python3

# Optional legacy Apify ingestion
APIFY_API_URL=
APIFY_API_KEY=
APIFY_METHOD=POST
APIFY_INPUT_TEMPLATE={"searchTerms":["{{keyword}}"],"maxItems":100}
APIFY_QUERY_PARAMS=
APIFY_TIMEOUT_MS=120000
